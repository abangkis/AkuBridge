{
  "manifest_version": 3,
  "name": "AkuBridge",
  "version": "0.7.3.0",
  "version_name": "0.7.3",
  "description": "Read-only, bounded browser observation bridge for AkuBrowser.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:11122/*",
    "http://localhost:11122/*",
    "https://x.com/*",
    "https://www.linkedin.com/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:11122/*",
        "http://localhost:11122/*"
      ],
      "js": [
        "aku-browser-tab-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "x-response-evidence-adapter.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "x-media-evidence-runtime.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.linkedin.com/*",
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "bounded-capture-policy.js",
        "capture-quality-policy.js",
        "linkedin-permalink-policy.js",
        "linkedin-timestamp-policy.js",
        "source-adapter-runtime.js",
        "adapters/x-adapter.js",
        "adapters/linkedin-adapter.js",
        "adapters/facebook-adapter.js",
        "source-freshness-runtime.js",
        "media-acquisition-engine.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open AkuBrowser"
  }
}
