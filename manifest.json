{
  "manifest_version": 3,
  "name": "AkuBrowser",
  "short_name": "AkuBrowser",
  "version": "0.7.9.0",
  "version_name": "0.7.9",
  "key": "",
  "description": "Build a private AI feed from the X, LinkedIn, Facebook, and Instagram sources you explicitly enable.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://github.com/abangkis/AkuBrowser",
  "permissions": [
    "scripting",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:11122/*",
    "http://localhost:11122/*"
  ],
  "optional_host_permissions": [
    "https://x.com/*",
    "https://www.linkedin.com/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "setup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:11122/*",
        "http://localhost:11122/*"
      ],
      "js": [
        "aku-browser-tab-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open AkuBrowser",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
